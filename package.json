{
	"name": "json-value-navigation",
	"author": {
		"name": "thycooon"
	},
	"displayName": "JSON Value Navigation",
	"description": "Navigate between JSON values",
	"license": "MIT",
	"version": "1.1.3",
	"configurations": [
		{
		"name": "Launch Extension",
		"type": "extensionHost",
		"request": "launch",
		"runtimeExecutable": "${execPath}",
		"args": [
			"--extensionDevelopmentPath=${workspaceFolder}",
			"--verbose" 
		]
		}
	],
	"publisher": "thycooon",
	"repository": {
		"type": "git",
		"url": "https://github.com/thycooon/json-value-navigation.git"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onLanguage:json"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "jsonValueNavigation.next",
				"title": "JSON Value Navigation: Next Value"
			},
			{
				"command": "jsonValueNavigation.previous",
				"title": "JSON Value Navigation: Previous Value"
			}
		],
		"keybindings": [
			{
				"command": "jsonValueNavigation.next",
				"key": "ctrl+alt+shift+right",
				"when": "editorTextFocus && (editorLangId == json || editorLangId == jsonc)"
			},
			{
				"command": "jsonValueNavigation.previous",
				"key": "ctrl+alt+shift+left",
				"when": "editorTextFocus && (editorLangId == json || editorLangId == jsonc)"
			}
		],
		"configuration": {
			"title": "JSON Value Navigation",
			"properties": {
				"jsonValueNavigation.enterNestedContainers": {
					"type": "boolean",
					"default": true,
					"description": "Navigate into non-empty JSON objects and arrays instead of treating each container as a single value."
				},
				"jsonValueNavigation.iterateContainerItems": {
					"type": "boolean",
					"default": true,
					"description": "When entering nested containers, navigate through inner values one by one. If disabled, arrays/objects are selected as whole values."
				},
				"jsonValueNavigation.minNestingLevel": {
					"type": "integer",
					"default": 0,
					"minimum": 0,
					"description": "Minimum JSON nesting level to include in navigation targets. Root value is level 0, its direct children are level 1, etc."
				}
			}
		}
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.6.5",
		"@types/vscode": "^1.80.0",
		"globals": "^17.13.0",
		"typescript": "^7.0.2"
	}
}
